pipeline {
    agent any 

    stages{
        stage('pull'){
            steps{
                echo 'pulling code from git'
            }
        }
           stage('build'){
            steps{
                echo 'building the code'
            }
        }
           stage('test'){
            steps{
                echo 'testing the code'
            }
        }
           stage('deploy'){
            steps{
                echo 'deploying the code'
            }
        }
    }
}
